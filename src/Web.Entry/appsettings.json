{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // 仅开发用,生产密钥环境变量注入(不入库;见 .gitignore)
  "ConnectionStrings": {
    // 存量单库配置保留:ConnectionConfigs 缺失时的兼容回落入口(见 SqlSugarSetup.LoadConnectionConfigs)
    "Default": "Host=localhost;Port=5432;Database=huluyeye_admin;Username=huluyeye;Password=huluyeye_dev_2026",
    // Redis 缓存(task_007 M2a)。开发环境地址;生产必须环境变量注入。
    // dev redis 已启用密码(盲审 2026-08-26 实测 NOAUTH):启用密码的环境以环境变量
    // ConnectionStrings__Redis 注入完整连接串(含 password= 段),密码本身不入库
    "Redis": "localhost:6379"
  },
  // 多库连接(task_008 多库通用选库):ConfigId 恒为 string,main 必备、log 可选。
  // log 未配置时 [LogTable] 实体自动回落 main(见 SelectConfigIdFor),不影响启动。
  // 日志库独立连接串:库 huluyeye_admin_log 需 DBA 预先创建且授权当前账号,故默认注释;
  // 开启时取消注释并确认连接串指向已存在的日志库。
  "ConnectionConfigs": [
    {
      "ConfigId": "main",
      "ConnectionString": "Host=localhost;Port=5432;Database=huluyeye_admin;Username=huluyeye;Password=huluyeye_dev_2026"
    }
    // {
    //   "ConfigId": "log",
    //   "ConnectionString": "Host=postgres;Port=5432;Database=huluyeye_admin_log;Username=huluyeye;Password=huluyeye_dev_2026"
    // }
  ],
  // CodeFirst 建表模式(task_008):true=增量(仅 [IncreTable] 实体)、false=全量(首次部署口径)
  "DbSettings": {
    "EnableIncreTable": true,
    // 慢 SQL 阈值(批 J 5.5):执行时间超过该秒数记 Warning(原生 SQL+堆栈首帧);<=0=关闭检测
    "SlowSqlSeconds": 5
  },
  // 雪花工作节点 Id(多实例部署必须唯一;取值 0-63,默认 1)
  "Yit": {
    "WorkerId": 1
  },
  // JWT 鉴权(HS256 对称密钥,长度须 ≥32 字节)。开发占位密钥,仅开发用;
  // 生产必须环境变量注入(如 Jwt__Secret),占位值不得带进生产
  "Jwt": {
    "Secret": "huluyeye-dev-only-jwt-secret-2026-change-me",
    "Issuer": "huluyeye-admin",
    "Audience": "huluyeye-admin-api"
  },
  // 缓存实现(task_007):Redis(默认) / Memory;显式配置决定实现,不做运行期切换
  "Cache": {
    "Type": "Redis"
  },
  // OTP 双因子(task_007):otpauth URI 的展示名。批 AY(G24)起**不再在文件里写死**——
  // 留空 = 回落 App:Name(站点身份单一真源);需单独区分时用 env Otp__Issuer 覆盖(优先级最高)
  "Otp": {},
  // AES 对称密钥(task_007):Base64 编码 32 字节。开发占位,仅开发用;
  // 生产必须环境变量注入(如 Cryptogram__Key),占位值不得带进生产
  "Cryptogram": {
    "Key": "ea5oJ38ITVQIH5b9qk/a7pQbUzwASIvVDEY/uYe5mLM="
  },
  // 文件上传(task_012):本地/DB 两档存储,显式配置决定实现,不做运行期切换(切换 EnableSaveDb 需重启;
  // 历史数据读取按记录 Provider 字段路由,切换不破坏历史)。仅开发用,生产可环境变量注入(如 Upload__EnableSaveDb)。
  "Upload": {
    // EnableSaveDb: true=内容落 sys_file_content 表, false=本地 wwwroot/uploads 物理文件
    "EnableSaveDb": false,
    // MaxSize: 单文件大小上限(KB);10240 = 10MB
    "MaxSize": 10240,
    // ContentType: 类型白名单(MIME,忽略大小写精确匹配;表外类型 400)
    "ContentType": [
      "image/jpeg",
      "image/png",
      "image/gif",
      "image/webp",
      "application/pdf",
      "text/plain"
    ],
    // EnableMd5: MD5 去重(同 MD5+大小视为同一文件,重传复用已有记录不产生新行)
    "EnableMd5": true,
    // AllowSuffix: 允许后缀与规范化(键=原后缀小写 → 值=规范后缀小写;表外后缀 400,如 jpeg→jpg)
    "AllowSuffix": {
      "jpg": "jpg",
      "jpeg": "jpg",
      "png": "png",
      "gif": "gif",
      "webp": "webp",
      "pdf": "pdf",
      "txt": "txt"
    }
  },
  "AllowedHosts": "*"
}
