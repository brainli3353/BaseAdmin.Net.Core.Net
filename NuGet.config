<?xml version="1.0" encoding="utf-8"?>
<!-- 2026-08-29:api.nuget.org 在国内被 302 重定向到 nuget.azure.cn,但 NuGet 客户端 audit(漏洞检查)
     跟随重定向后未用 azure.cn 的 VulnerabilityInfo 资源 → NU1903 等漏洞警告在服务器侧静默丢失。
     直连 azure.cn(其 service index 带 VulnerabilityInfo/6.7.0,国内直连快)——恢复服务器侧 audit。 -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org-cn" value="https://nuget.azure.cn/v3/index.json" />
  </packageSources>
</configuration>