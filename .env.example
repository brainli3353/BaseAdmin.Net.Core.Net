# BaseAdminCore 环境变量样例
# 复制为 .env（已被 .gitignore 忽略）后按需修改；docker compose 自动读取本文件同级的 .env。

# ---------- PostgreSQL（docker-compose.yml 消费） ----------
POSTGRES_USER=huluyeye
POSTGRES_PASSWORD=huluyeye_dev_2026
POSTGRES_DB=huluyeye_admin
POSTGRES_PORT=5432

# ---------- Redis（docker-compose.yml 消费） ----------
REDIS_PORT=6379

# ---------- 应用配置注入（可选，最高优先级；冒号→双下划线） ----------
# 开发环境用 docker compose 的默认值即可，下列仅示意生产注入通道。
# ConnectionConfigs__0__ConnectionString=Host=localhost;Port=5432;Database=huluyeye_admin;Username=huluyeye;Password=huluyeye_dev_2026
# ConnectionStrings__Default=Host=localhost;Port=5432;Database=huluyeye_admin;Username=huluyeye;Password=huluyeye_dev_2026
# ConnectionStrings__Redis=localhost:6379
# DbSettings__EnableIncreTable=true
# Yit__WorkerId=1
# Jwt__Secret=change-me-prod-secret-min-32-bytes
# Cryptogram__Key=change-me-base64-32-bytes
# App__Name=BaseAdmin
